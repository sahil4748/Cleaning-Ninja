# Required for durable acceptance. Server-only; never NEXT_PUBLIC.
# PostgreSQL connection string; provider-issued pooled URL with verified TLS in production.
LEAD_DATABASE_URL=
# Random secret, minimum 32 characters, for non-reversible phone rate identifiers.
LEAD_RATE_LIMIT_SECRET=
# Required for email. Resend API key and authenticated, provider-verified sender address.
RESEND_API_KEY=
LEAD_EMAIL_FROM=
# Required for scheduled outbox recovery. Independent random secret, minimum 32 characters.
LEAD_WORKER_SECRET=
